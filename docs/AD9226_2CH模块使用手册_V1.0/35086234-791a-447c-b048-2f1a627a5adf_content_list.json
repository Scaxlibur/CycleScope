td><td>PIN_F9</td></tr><tr><td>in  $\\rightarrow$  Adc_In_B[9]</td><td>Location</td><td>PIN_N11</td></tr><tr><td>in  $\\rightarrow$  Adc_In_B[10]</td><td>Location</td><td>PIN_F10</td></tr><tr><td>in  $\\rightarrow$  Adc_In_B[11]</td><td>Location</td><td>PIN_C8</td></tr><tr><td>in  $\\rightarrow$  Otr_B</td><td>Location</td><td>PIN_D11</td></tr><tr><td>in  $\\rightarrow$  Ext_Rst_n</td><td>Location</td><td>PIN_M1</td></tr><tr><td>in  $\\rightarrow$  Ext_Clk</td><td>Location</td><td>PIN_E1</td></tr></table>",
